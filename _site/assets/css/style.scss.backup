@import "minima";

/* Custom site-wide tweaks */
:root {
  --accent: #0f62fe;
  --text: #1c1e21;
  --muted: #606770;
}

/* Ensure responsive viewport */
* {
  box-sizing: border-box;
}

/* Basic responsive setup */
html {
  -webkit-text-size-adjust: 100%;
  -ms-text-size-adjust: 100%;
}

html,
body {
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Constrain content width for readability on large screens */
.wrapper,
.container,
main,
.content {
  max-width: 960px;
}

/* Typography */
body {
  font-size: 16px;
  line-height: 1.7;
}

h1,
h2,
h3 {
  letter-spacing: -0.015em;
}

h1 { font-size: 2.2rem; }
h2 { font-size: 1.45rem; border-bottom: 2px solid #f0f2f5; padding-bottom: 0.35rem; }

/* Links */
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* Lists spacing */
ul { margin-top: 0.5rem; }
li { margin: 0.3rem 0; }

/* Muted metadata text helper (if needed) */
.meta { color: var(--muted); font-size: 0.95rem; }

/* Mobile navigation and responsiveness improvements */
@media (max-width: 720px) {
  h1 { font-size: 1.8rem; }
  h2 { font-size: 1.25rem; }
  
  /* Improve readability on mobile */
  body {
    font-size: 15px;
    line-height: 1.6;
    padding: 10px;
  }

  /* Better spacing for mobile */
  .wrapper {
    width: 100%;
    padding: 15px;
    margin: 0 auto;
  }

  /* Ensure content is readable on small screens */
  .container {
    width: 100%;
    padding: 0 10px;
  }

  /* Make links more tappable on mobile */
  a {
    padding: 5px 0;
    display: inline-block;
  }

  /* Improve list readability on mobile */
  li {
    margin: 0.5rem 0;
    padding-right: 10px;
  }

  /* Ensure images don't overflow on mobile */
  img {
    max-width: 100%;
    height: auto;
  }
}


